name: Update standings
on:
  schedule:
    - cron: "0 11 * * *"
  workflow_dispatch: {}
permissions:
  contents: write
jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: python scripts/update_standings.py
      - name: Commit if changed
        run: |
          git config user.name "standings-bot"
          git config user.email "bot@users.noreply.github.com"
          git add data/standings.json
          git diff --cached --quiet || (git commit -m "Update standings" && git push)
